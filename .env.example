# Copy to `.env` (Windows: copy .env.example .env) and adjust. Every value has a working default.

# Where this service listens. The backend's LLM_SERVICE_URL must point here.
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=8100
# Optional shared secret. When set, the backend must send the same value (its LLM_SERVICE_API_KEY).
LLM_SERVICE_API_KEY=

# Ollama. Qwen 3.6 needs ~17 GB (qwen3.6:27b) to ~24 GB (qwen3.6 = 35b-a3b) of RAM/VRAM.
# On a smaller machine, point OLLAMA_BASE_URL at a GPU server, or use a smaller model for development.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6
OLLAMA_TIMEOUT_S=180
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=10m
LLM_TEMPERATURE=0.1
# Qwen "thinking" mode: better reasoning, much slower on CPU.
LLM_THINK=false

# Agent loops (the backend's Settings page can override these per request).
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_REVISIONS=2
AGENT_ENABLE_REFLECTION=true
# Answer with the rule-based planner when Ollama/the model is unavailable, so demos keep working.
AGENT_OFFLINE_FALLBACK=true
EXTRACTION_MAX_ATTEMPTS=3
